{
  "name": "diskatlas",
  "productName": "DiskAtlas",
  "version": "0.1.0",
  "description": "A clear view of your storage. Local, open-source disk analysis for Windows.",
  "author": "Ishara Lakshan",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/build.mjs && node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "package:win": "npm run build && electron-builder --win --x64",
    "start": "electron ."
  },
  "build": {
    "appId": "xyz.isharalakshan.diskatlas",
    "productName": "DiskAtlas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico",
      "artifactName": "DiskAtlas-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "DiskAtlas-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "DiskAtlas-${version}-win-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  }
}
